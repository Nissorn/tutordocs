{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TutorDocs",
  "version": "1.0.0",
  "identifier": "com.tutordocs.reader",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "reader",
        "title": "TutorDocs",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: visual:; frame-src 'self' visual:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Nissorn/tutordocs/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBBRjMyNjJDODMxODY4MTgKUldRWWFCaURMQ2J6Q2syendDbDN2eTJWRkFUTHZ4RVIzSTdUb0lUVzlXS3Z3Y0dhd3hXR3ptQmwK"
    }
  }
}