(version 1)
(allow default)
(deny file-write* (subpath "/Users") (subpath "/private/tmp") (subpath "/private/var/tmp"))
(deny file-read* (subpath "@HOME@"))
(allow file-read* file-write*
  (subpath "@JOB@")
  (subpath "@HOME@/.gemini")
  (subpath "@HOME@/Library/Application Support/Antigravity")
  (subpath "@HOME@/Library/Caches/antigravity")
  (subpath "@HOME@/Library/Caches/com.google.antigravity"))
(allow file-read*
  (literal "@HOME@")
  (subpath "@HOME@/.local/bin")
  (subpath "@HOME@/Library/Keychains")
  (subpath "@HOME@/Library/Preferences"))
(deny process-exec)
(allow process-exec (literal "@HOME@/.local/bin/agy"))
(allow process-exec (literal "/usr/bin/security"))
(deny file-read* (literal "@HOME@/.gemini/config/hooks.json") (literal "@HOME@/.gemini/config/hooks.json.bak"))
